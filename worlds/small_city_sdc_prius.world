    <plugin name='gazebo_occupancy_map' filename='libgazebo_2Dmap_plugin.so'>
      <map_resolution>0.05</map_resolution>
      <map_height>0.1</map_height>

      <map_size_x>400.0</map_size_x> <map_size_y>140.0</map_size_y> <init_robot_x>0.0</init_robot_x>
      <init_robot_y>0.0</init_robot_y>
    </plugin>
