          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Black</name>
            </script>
          </material>
        </visual>
        <sensor name='velodyne-VLP16' type='gpu_ray'>
          <pose>0 0 0 0 -0 0</pose>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>1200</samples>
                <resolution>1</resolution>
                <min_angle>-3.1415926535897931</min_angle>
                <max_angle>3.1415926535897931</max_angle>
              </horizontal>
              <vertical>
                <samples>32</samples>
                <resolution>1</resolution>
                <min_angle>-0.434586983089577</min_angle>
                <max_angle>0.0349065850398866</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.055</min>
              <max>50.0</max>
              <resolution>0.001</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </ray>
          <plugin name='gazebo_ros_velodyne_laser' filename='libgazebo_ros_ray_sensor.so'>
            <ros>
              <remapping>~/out:=/points_raw</remapping>
            </ros>
            <output_type>sensor_msgs/PointCloud2</output_type>
            <frame_name>velodyne</frame_name>
            <min_range>0.9</min_range>
            <max_range>50.0</max_range>
            <gaussianNoise>0.008</gaussianNoise>
          </plugin>
        </sensor>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
      <joint name='velodyne_joint' type='fixed'>
        <parent>chassis</parent>
        <child>velodyne</child>
      </joint>
