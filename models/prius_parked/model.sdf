            <size>1.168381 1.654253 0.272347</size>
          </box>
        </geometry>
      </collision>

      <collision name="top_front">
        <pose>0 0.161236 1.386042 0.135030 0 0</pose>
        <geometry>
          <box>
            <size>1.279154 0.625988 0.171868</size>
          </box>
        </geometry>
      </collision>

      <collision name="top_rear">
        <pose>0 0.817696 1.360069 -0.068997 0 0</pose>
