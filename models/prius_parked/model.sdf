      <collision name="back_bumper">
        <pose>0 2.054454 0.577870 0 0 0</pose>
        <geometry>
          <box>
            <size>1.781650 0.512093 0.581427</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
