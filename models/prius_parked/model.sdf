<?xml version="1.0"?>
<sdf version="1.6">
  <model name="prius_parked">
    <static>true</static>
    <pose>0 0 0.03 0 0 0</pose>
    <link name="body">
      <!-- Match the +90 degree internal yaw used by the hatchback models that
           these parked cars replace, so the existing world poses stay valid. -->
      <pose>0 0 0 0 0 1.57079632679</pose>

      <visual name="chassis_visual">
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.01 0.01 0.01</scale>
            <submesh>
              <name>Hybrid</name>
              <center>false</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>

      <visual name="interior_visual">
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.01 0.01 0.01</scale>
            <submesh>
              <name>Hybrid_Interior</name>
              <center>false</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>

      <visual name="windows_visual">
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.01 0.01 0.01</scale>
            <submesh>
              <name>Hybrid_Windows</name>
              <center>false</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>

      <visual name="front_left_wheel_visual">
        <pose>0.80 -1.41 0.3 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.01 0.01 0.01</scale>
            <submesh>
              <name>Wheel_Front_Left_</name>
              <center>true</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>

      <visual name="front_right_wheel_visual">
        <pose>-0.76 -1.41 0.3 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.01 0.01 0.01</scale>
            <submesh>
              <name>Wheel_Front_Right</name>
              <center>true</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>

      <visual name="rear_left_wheel_visual">
        <pose>0.826 1.45 0.3 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.01 0.01 0.01</scale>
            <submesh>
              <name>Wheel_Front_Left_</name>
              <center>true</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>

      <visual name="rear_right_wheel_visual">
        <pose>-0.826 1.45 0.3 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://prius_hybrid/meshes/Hybrid.obj</uri>
            <scale>0.01 0.01 0.01</scale>
            <submesh>
              <name>Wheel_Front_Right</name>
              <center>true</center>
            </submesh>
          </mesh>
        </geometry>
      </visual>

      <collision name="chassis">
        <pose>0 0.05 0.625 0 0 0</pose>
        <geometry>
          <box>
            <size>1.7526 2.1 0.95</size>
          </box>
        </geometry>
      </collision>

      <collision name="front_bumper">
        <pose>0 -2.0 0.458488 0 0 0</pose>
